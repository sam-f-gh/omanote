# Local build of the working tree for bin/install. The released package's
# recipe lives in omacom/omarchy-pkgs and builds from the tagged tarball.
pkgname=omanote
pkgver=$(sed -n 's/^VERSION = //p' "$startdir/../omanote.pro")
pkgrel=1
pkgdesc='Minimalist PDF notes and annotation for pen, touch and keyboard'
arch=('x86_64' 'aarch64')
url='https://github.com/sam-f-gh/omanote'
license=('MIT')
options=('!debug')
depends=('hicolor-icon-theme' 'poppler-qt6' 'qpdf' 'qt6-base' 'qt6-declarative' 'wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'pkgconf' 'wayland-protocols')
# The PDF round-trip test writes text and reads it back, which needs a font.
checkdepends=('ttf-liberation')

build() {
  cd "$startdir/.."
  ./bin/build
}

check() {
  cd "$startdir/.."
  ./bin/test
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omanote "$pkgdir/usr/bin/omanote"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omanote.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omanote.svg"
  install -Dm644 "$startdir/omanote.desktop" "$pkgdir/usr/share/applications/omanote.desktop"
}

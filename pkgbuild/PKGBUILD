pkgname=omanote
pkgver=0.1.0
pkgrel=1
pkgdesc='Minimalist PDF notes and annotation for pen, touch and keyboard'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'poppler-qt6' 'qpdf' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omanote "$pkgdir/usr/bin/omanote"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omanote.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omanote.svg"
  install -Dm644 "$startdir/omanote.desktop" "$pkgdir/usr/share/applications/omanote.desktop"
}
